{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "background", "name": "Background", "color": "#f7f7f7" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "foreground", "name": "Foreground", "color": "#1f2328" },
        { "slug": "muted", "name": "Muted", "color": "#59636e" },
        { "slug": "primary", "name": "Primary", "color": "#101828" },
        { "slug": "accent", "name": "Accent", "color": "#2f6feb" }
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1200px"
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.4,
        "steps": 7,
        "mediumStep": 1.2,
        "unit": "rem"
      },
      "units": ["px", "rem", "em", "%", "vw"]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ],
      "fontSizes": [
        { "slug": "s", "size": "0.875rem", "name": "S" },
        { "slug": "m", "size": "1rem", "name": "M" },
        { "slug": "l", "size": "1.25rem", "name": "L" },
        { "slug": "xl", "size": "1.75rem", "name": "XL" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "8px"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--surface)"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    }
  }
}

